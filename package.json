{
  "name": "app-casamento-monorepo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "app:install": "npm --prefix apps/app ci",
    "portal:install": "npm --prefix apps/portal ci",
    "app:dev": "npm --prefix apps/app run dev",
    "portal:dev": "npm --prefix apps/portal run dev",
    "app:lint": "npm --prefix apps/app run lint",
    "app:typecheck": "npm --prefix apps/app run typecheck",
    "portal:typecheck": "npm --prefix apps/portal run typecheck",
    "app:test": "npm --prefix apps/app run test",
    "portal:test": "npm --prefix apps/portal run test",
    "app:build": "npm --prefix apps/app run build",
    "portal:build": "npm --prefix apps/portal run build"
  }
}
