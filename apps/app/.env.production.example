APP_PORT=3010
COMPOSE_PROJECT_NAME=app_casamento

POSTGRES_DB=album_casamento
POSTGRES_USER=album_user
POSTGRES_PASSWORD=<SENHA_FORTE_DO_POSTGRES>

DATABASE_URL=postgresql://album_user:<SENHA_FORTE_DO_POSTGRES>@db:5432/album_casamento?schema=public
APP_BASE_URL=https://casamento.example.com
ADMIN_API_KEY=<CHAVE_ADMIN_FORTE>
CLIENT_HASH_SECRET=<SEGREDO_LONGO_PARA_HASH_DE_CLIENTE>

BUNNY_STORAGE_ENDPOINT=<NOVO_ENDPOINT_BUNNY>
BUNNY_STORAGE_PASSWORD=<NOVA_SENHA_STORAGE_ZONE>
BUNNY_PUBLIC_BASE_URL=<URL_PUBLICA_DA_PULL_ZONE>

BUNNY_STREAM_LIBRARY_ID=<ID_DA_STREAM_LIBRARY>
BUNNY_STREAM_API_KEY=<API_KEY_DA_STREAM_LIBRARY>
BUNNY_STREAM_PULL_ZONE_HOSTNAME=<HOSTNAME_DA_PULL_ZONE_STREAM>
BUNNY_STREAM_WEBHOOK_SECRET=<READ_ONLY_API_KEY_DO_WEBHOOK_STREAM>
BUNNY_STREAM_REQUEST_TIMEOUT_MS=10000

# Opcional: limite global de processamento Sharp por processo Node.
PHOTO_PROCESSING_CONCURRENCY=2
