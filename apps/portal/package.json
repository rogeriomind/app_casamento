{
  "name": "nosso-album",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:test:deploy": "node scripts/migrate-test.mjs",
    "db:status": "prisma migrate status",
    "media:seed-rogerio": "tsx scripts/import-rogerio-event-media.ts",
    "media:thumbnails": "tsx scripts/generate-media-thumbnails.ts",
    "capture:link": "node --conditions=react-server --import tsx scripts/link-capture-event.ts",
    "capture:sync-all": "node --conditions=react-server --import tsx scripts/sync-capture-all.ts",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres.ps1 start",
    "db:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres.ps1 stop",
    "test": "node --import tsx --test tests/*.unit.test.ts",
    "typecheck": "tsc --noEmit",
    "pretest:e2e": "npm run build && npm run db:test:deploy",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.3",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.3",
    "nodemailer": "^7.0.6",
    "dotenv": "^17.4.2",
    "next": "^16.3.4",
    "pg": "^8.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
