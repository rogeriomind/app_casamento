[Unit]
Description=Synchronize portal media from capture integrations
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/opt/apps/app_casamento_portal
ExecStart=/usr/bin/flock -n /run/app-casamento-capture-sync.lock /usr/bin/docker compose --project-name app_casamento_portal --env-file /opt/apps/app_casamento_portal/.env run --rm --no-deps app npm run capture:sync-all
